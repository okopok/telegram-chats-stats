{% if data.total_edited == 0 %}
    <blockquote>В этом чате никто не исправлял свои сообщения.</blockquote>
{% else %}
    <blockquote>
        Всего исправлено {{ data.total_edited|number_format(0, '.', ' ') }} из
        {{ data.total|number_format(0, '.', ' ') }} сообщений
        ({{ ((data.total_edited / data.total) * 100)|round(1) }}%).
    </blockquote>
    <table class="table table-striped table-condensed">
        <thead>
        <tr>
            <th>Участник</th>
            <th>Правок ✏️</th>
            <th>Всего сообщений</th>
            <th>Доля правок</th>
        </tr>
        </thead>
        <tbody>
        {% for row in data.by_user %}
            <tr>
                <td>{{ row.user|user_link }}</td>
                <td>{{ row.edited|number_format(0, '.', ' ') }}</td>
                <td>{{ row.total|number_format(0, '.', ' ') }}</td>
                <td>{{ row.share }}%</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endif %}