{% if data.chat is null %}
    <blockquote>Нет данных об активности по дням.</blockquote>
{% else %}
    <div class="well">
        <strong>🔥 Рекорд чата: {{ data.chat.days|number_format(0, '.', ' ') }} дней подряд</strong>
        с сообщениями — с {{ data.chat.start }} по {{ data.chat.end }}.
    </div>
    {% if data.users is not empty %}
        <h4>Персональные рекорды</h4>
        <table class="table table-striped table-condensed">
            <thead>
            <tr>
                <th>Участник</th>
                <th>Дней подряд</th>
                <th>Период</th>
            </tr>
            </thead>
            <tbody>
            {% for row in data.users %}
                <tr>
                    <td>{{ row.user|user_link }}</td>
                    <td>{{ row.days|number_format(0, '.', ' ') }}</td>
                    <td>{{ row.start }} — {{ row.end }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endif %}