{% if data is not empty %}
    {# Граф коммуникаций: кто кому отвечает (SVG, рисуется JS-ом). #}
    <div id="{{ templateKey }}_graph"></div>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var matrix = {{ data|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }};
            var users = Object.keys(matrix).sort();
            var byTarget = {};
            users.forEach(function (from) {
                Object.keys(matrix[from] || {}).forEach(function (to) {
                    if (byTarget[to] === undefined) byTarget[to] = {};
                    byTarget[to][from] = matrix[from][to];
                });
            });
            var all = {};
            users.forEach(function (u) { all[u] = 1; });
            Object.keys(byTarget).forEach(function (u) { all[u] = 1; });
            var names = Object.keys(all).sort();
            if (names.length < 2) return;

            var width = 640, height = 480;
            var cx = width / 2, cy = height / 2, R = Math.min(cx, cy) - 70;
            var html = '<svg width="100%" viewBox="0 0 ' + width + ' ' + height + '" style="background: var(--panel-2); border-radius: 8px;">';

            // Рёбра: from → to, толщина зависит от количества реплаев.
            var maxEdge = 1;
            users.forEach(function (from) {
                Object.keys(matrix[from] || {}).forEach(function (to) {
                    if (matrix[from][to] > maxEdge) maxEdge = matrix[from][to];
                });
            });
            users.forEach(function (from) {
                Object.keys(matrix[from] || {}).forEach(function (to) {
                    var a = 2 * Math.PI * names.indexOf(from) / names.length - Math.PI / 2;
                    var b = 2 * Math.PI * names.indexOf(to) / names.length - Math.PI / 2;
                    var x1 = cx + R * Math.cos(a), y1 = cy + R * Math.sin(a);
                    var x2 = cx + R * Math.cos(b), y2 = cy + R * Math.sin(b);
                    var weight = 1 + 4 * matrix[from][to] / maxEdge;
                    html += '<line x1="' + x1.toFixed(1) + '" y1="' + y1.toFixed(1) +
                            '" x2="' + x2.toFixed(1) + '" y2="' + y2.toFixed(1) +
                            '" stroke="var(--accent)" stroke-opacity="0.25" stroke-width="' + weight.toFixed(1) + '"/>';
                });
            });

            // Узлы участников.
            names.forEach(function (name, i) {
                var a = 2 * Math.PI * i / names.length - Math.PI / 2;
                var x = cx + R * Math.cos(a), y = cy + R * Math.sin(a);
                html += '<circle cx="' + x.toFixed(1) + '" cy="' + y.toFixed(1) + '" r="8" fill="var(--accent)" stroke="var(--bg)" stroke-width="2"/>';
                var label = name.length > 18 ? name.slice(0, 17) + '…' : name;
                html += '<text x="' + x.toFixed(1) + '" y="' + (y + 22).toFixed(1) + '" text-anchor="middle" font-size="11" fill="var(--text)">' + label.replace(/&/g, '&amp;').replace(/</g, '&lt;') + '</text>';
            });

            html += '</svg>';
            document.getElementById('{{ templateKey }}_graph').innerHTML =
                '<h4>Кто кому отвечает</h4>' + html;
        });
    </script>
    <hr/>
{% endif %}
<div class="accordion" id="accordion2_countRepliesByUser">
    {% for username, stat in data %}
        <div class="accordion-group">
            <div class="accordion-heading">
                <a class="accordion-toggle collapsed" data-toggle="collapse"
                   data-parent="#accordion2_countRepliesByUser_" href="#countRepliesByUser_{{ username|md5 }}">
                    {{ username|user_link }}
                </a>
            </div>
            <div id="countRepliesByUser_{{ username|md5 }}" class="accordion-body collapse">
                <div class="accordion-inner">
                    <ol>
                        {% for user, ct in stat %}
                            <li>{{ user|user_link }} — {{ ct|number_format(0, '.', ' ') }}</li>
                        {% endfor %}
                    </ol>
                </div>
            </div>
        </div>
    {% endfor %}
</div>
