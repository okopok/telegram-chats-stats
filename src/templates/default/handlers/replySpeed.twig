{% if data.by_user is empty %}
    <blockquote>В этом чате нет реплаев, по которым можно посчитать скорость ответа.</blockquote>
{% else %}
    <blockquote>
        Медианное время между сообщением и ответом на него (только реплаи в пределах недели).
    </blockquote>
    {% set fastest = data.by_user|first %}
    <table class="table table-striped table-condensed">
        <thead>
        <tr>
            <th>Участник</th>
            <th>Ответов</th>
            <th>Медиана</th>
            <th>Среднее</th>
        </tr>
        </thead>
        <tbody>
        {% for row in data.by_user %}
            <tr>
                <td>
                    {{ row.user|user_link }}
                    {% if loop.first and row.count >= 5 %} 🥇{% endif %}
                </td>
                <td>{{ row.count|number_format(0, '.', ' ') }}</td>
                <td>{{ row.median_sec|duration }}</td>
                <td>{{ row.mean_sec|duration }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endif %}