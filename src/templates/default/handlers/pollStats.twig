{% if data.polls is empty %}
    <blockquote>В этом чате пока не было опросов.</blockquote>
{% else %}
    <blockquote>Всего опросов: {{ data.total|number_format(0, '.', ' ') }}.</blockquote>
    <h4>Кто создаёт опросы</h4>
    <table class="table table-striped table-condensed">
        <thead>
        <tr>
            <th>Участник</th>
            <th>Опросов</th>
        </tr>
        </thead>
        <tbody>
        {% for row in data.by_user %}
            <tr>
                <td>{{ row.user|user_link }}</td>
                <td>{{ row.count|number_format(0, '.', ' ') }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    <div class="accordion" id="accordion2_{{ templateKey }}">
        {% for poll in data.polls %}
            <div class="accordion-group">
                <div class="accordion-heading">
                    <a class="accordion-toggle collapsed" data-toggle="collapse"
                       data-parent="#accordion2_{{ templateKey }}"
                       href="#{{ templateKey }}_{{ poll.id }}">
                        📊 {{ poll.question|default('(без вопроса)') }}
                        <small>— {{ poll.from|user_link }}, {{ poll.date|date('d.m.Y H:i') }}</small>
                    </a>
                </div>
                <div id="{{ templateKey }}_{{ poll.id }}" class="accordion-body collapse">
                    <div class="accordion-inner">
                        <ul>
                            {% for answer in poll.answers %}
                                <li>{{ answer }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endif %}