{% if data.max == 0 %}
    <blockquote>Нет данных об активности по часам.</blockquote>
{% else %}
    <blockquote>Интенсивность цвета — от количества сообщений в час (тёмнее = активнее).</blockquote>
    <div style="overflow-x: auto;">
        <table class="table table-condensed heatmap">
            <thead>
            <tr>
                <th>День</th>
                {% for h in range(0, 23) %}
                    <th{% if h is divisible by(2) %} class="hour-even"{% endif %}>{{ h }}</th>
                {% endfor %}
            </tr>
            </thead>
            <tbody>
            {% for row in data.rows %}
                <tr>
                    <td class="heatmap-day">{{ row.name }} <small>({{ row.count|number_format(0, '.', ' ') }})</small></td>
                    {% for cell in row.hours %}
                        {% if cell.count > 0 %}
                            <td class="heatmap-cell l{{ cell.level }}" title="{{ row.name }} {{ cell.hour }}:00 — {{ cell.count|number_format(0, '.', ' ') }}"></td>
                        {% else %}
                            <td class="heatmap-cell l0" title="{{ row.name }} {{ cell.hour }}:00"></td>
                        {% endif %}
                    {% endfor %}
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    <div class="heatmap-legend">
        Меньше
        {% for l in range(1, 10) %}<span class="heatmap-cell l{{ l }}" style="display:inline-block; width:14px; height:14px;"></span>{% endfor %}
        Больше
    </div>
{% endif %}