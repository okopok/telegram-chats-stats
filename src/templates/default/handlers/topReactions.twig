{% if data.totals is empty %}
    <blockquote>В этом чате пока нет реакций.</blockquote>
{% else %}
    <div class="row-fluid">
        <div class="span6">
            <h4>Топ эмодзи</h4>
            <canvas id="{{ templateKey }}_totals" width="400" height="300"></canvas>
        </div>
        <div class="span6">
            <h4>Реакции по типам сообщений</h4>
            <canvas id="{{ templateKey }}_bytype" width="400" height="300"></canvas>
        </div>
    </div>
    <div class="row-fluid">
        <div class="span6">
            <h4>Кому реагируют чаще всего</h4>
            <canvas id="{{ templateKey }}_leaders" width="400" height="{% if data.leaders|length > 10 %}{{ data.leaders|length * 10 }}{% else %}100{% endif %}"></canvas>
        </div>
        <div class="span6">
            <h4>Топ-3 эмодзи по участникам</h4>
            <table class="table table-striped table-condensed">
                <thead>
                <tr>
                    <th>Участник</th>
                    <th>Сообщений</th>
                    <th>Любимые реакции</th>
                </tr>
                </thead>
                <tbody>
                {% for row in data.by_user %}
                    <tr>
                        <td>{{ row.user|user_link }}</td>
                        <td>{{ row.total|number_format(0, '.', ' ') }}</td>
                        <td>
                            {% for r in row.top %}{{ r.emoji }} ×{{ r.count|number_format(0, '.', ' ') }}{% if not loop.last %}, {% endif %}{% endfor %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            new Chart('{{ templateKey }}_totals', {
                type: 'bar',
                data: {
                    labels: {{ data.totals|map(r => r.emoji)|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }},
                    datasets: [{
                        label: 'Реакции',
                        data: [{{ data.totals|map(r => r.count)|join(', ')|raw }}],
                    }]
                },
                options: {
                    plugins: {
                        colorschemes: {
                            scheme: 'brewer.Paired12'
                        }
                    },
                    responsible: true,
                    animation: {duration: 0},
                    hover: {animationDuration: 0},
                    responsiveAnimationDuration: 0
                }
            });
            new Chart('{{ templateKey }}_bytype', {
                type: 'bar',
                data: {
                    labels: {{ data.by_type|map(r => r.type)|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }},
                    datasets: [{
                        label: 'Реакции',
                        data: [{{ data.by_type|map(r => r.count)|join(', ')|raw }}],
                    }]
                },
                options: {
                    plugins: {
                        colorschemes: {
                            scheme: 'brewer.Paired12'
                        }
                    },
                    responsible: true,
                    animation: {duration: 0},
                    hover: {animationDuration: 0},
                    responsiveAnimationDuration: 0
                }
            });
            new Chart('{{ templateKey }}_leaders', {
                type: 'horizontalBar',
                data: {
                    labels: {{ data.leaders|map(r => r.user)|nicks|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }},
                    datasets: [{
                        label: 'Получено реакций',
                        data: [{{ data.leaders|map(r => r.received)|join(', ')|raw }}],
                    }]
                },
                options: {
                    plugins: {
                        colorschemes: {
                            scheme: 'brewer.Paired12'
                        }
                    },
                    responsible: true,
                    animation: {duration: 0},
                    hover: {animationDuration: 0},
                    responsiveAnimationDuration: 0
                }
            });
        });
    </script>
{% endif %}