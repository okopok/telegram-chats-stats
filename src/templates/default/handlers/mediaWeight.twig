{% if data.by_user is empty %}
    <blockquote>В этом чате нет медиа с известным весом или длительностью.</blockquote>
{% else %}
    <blockquote>
        Голосовых: {{ data.voice_total }} сек · Видео: {{ data.video_total }} сек ·
        Документов: {{ (data.docs_total_kb / 1024)|round(1) }} МБ
    </blockquote>
    <canvas id="{{ templateKey }}_voice" width="400"
            height="{% if data.by_user|length > 10 %}{{ data.by_user|length * 10 }}{% else %}100{% endif %}"></canvas>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            new Chart('{{ templateKey }}_voice', {
                type: 'horizontalBar',
                data: {
                    labels: {{ data.by_user|map(r => r.user)|nicks|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }},
                    datasets: [
                        {
                            label: 'Голосовые, сек',
                            data: [{{ data.by_user|map(r => r.voice_sec)|join(', ')|raw }}],
                        },
                        {
                            label: 'Видео, сек',
                            data: [{{ data.by_user|map(r => r.video_sec)|join(', ')|raw }}],
                        }
                    ]
                },
                options: {
                    plugins: {colorschemes: {scheme: 'brewer.Paired12'}},
                    responsible: true,
                    animation: {duration: 0},
                    hover: {animationDuration: 0},
                    responsiveAnimationDuration: 0
                }
            });
        });
    </script>
    <hr/>
    <table class="table table-striped table-condensed">
        <thead>
        <tr>
            <th>Участник</th>
            <th>Голосовые</th>
            <th>Видео</th>
            <th>Документы</th>
        </tr>
        </thead>
        <tbody>
        {% for row in data.by_user %}
            <tr>
                <td>{{ row.user|user_link }}</td>
                <td>{% if row.voice_sec > 0 %}{{ (row.voice_sec / 60)|round(1) }} мин ({{ row.voice_sec }} сек){% else %}—{% endif %}</td>
                <td>{% if row.video_sec > 0 %}{{ (row.video_sec / 60)|round(1) }} мин ({{ row.video_sec }} сек){% else %}—{% endif %}</td>
                <td>{% if row.docs_count > 0 %}{{ row.docs_mb|round(1) }} МБ, {{ row.docs_count }} шт.{% else %}—{% endif %}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endif %}