{% set now = 'now'|date('U') %}
<table class="table table-striped table-condensed">
    <thead>
    <tr>
        <th>Участник</th>
        <th>Последнее сообщение</th>
        <th>Когда</th>
    </tr>
    </thead>
    <tbody>
    {% for row in data.by_user %}
        <tr>
            <td>{{ row.user|user_link }}</td>
            <td>
                {% if row.text|length > 120 %}{{ row.text|slice(0, 120) }}…{% else %}{{ row.text|default('(не текст)') }}{% endif %}
            </td>
            <td>
                {% if row.ago_days == 0 %}
                    <span class="label label-success">сегодня</span>
                {% elseif row.ago_days < 7 %}
                    <span class="label label-warning">{{ row.ago_days }} дн. назад</span>
                {% elseif row.ago_days < 31 %}
                    <span class="label">{{ row.ago_days }} дн. назад</span>
                {% else %}
                    <span class="label label-inverse">{{ row.date|date('d.m.Y') }}</span>
                {% endif %}
            </td>
        </tr>
    {% endfor %}
    </tbody>
</table>