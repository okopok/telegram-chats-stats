{% if data.total == 0 %}
    <blockquote>Никто не отвечает сам себе. Идеальный чат.</blockquote>
{% else %}
    <blockquote>
        Всего {{ data.total|number_format(0, '.', ' ') }} реплаев на собственные сообщения.
    </blockquote>
    <table class="table table-striped table-condensed">
        <thead>
        <tr>
            <th>Участник</th>
            <th>Само-ответов</th>
        </tr>
        </thead>
        <tbody>
        {% for row in data.by_user %}
            <tr>
                <td>{{ row.user|user_link }}</td>
                <td>{{ row.count|number_format(0, '.', ' ') }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endif %}