#!/usr/bin/env php
<?php

// Экспорты большие (сотни МБ), а коллекция объектов Message на чаты
// с миллионом сообщений занимает ~1G. 2G — потолок для первых полных
// прогонов; повторные прогоны идут через кэш результатов (~20MB).
ini_set('memory_limit', '2G');

require dirname(__DIR__) . '/vendor/autoload.php';

exit((new ChatStats\Application())->run());